<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Baobabs.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Baobabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar placeholder: Collapsed by default -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Web Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Placeholder (for future use) -->
        <Border Grid.Column="0" x:Name="SidebarContainer" Visibility="Collapsed" Width="250" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <TextBlock Text="Bookmarks Sidebar" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>

        <!-- Browser Engine -->
        <WebView2 Grid.Column="1" x:Name="MyWebView" Source="https://duckduckgo.com" />
    </Grid>
</Page>
