<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Baobabs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Baobabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Baobabs"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" MaxWidth="800" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Controls & Draggable Area -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar Toggle Button -->
                <Button Grid.Column="0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Toggle Sidebar">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                    <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Forward">
                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </StackPanel>

                <!-- The background that acts as the draggable TitleBar on the left -->
                <Border x:Name="AppTitleBarLeft" Grid.Column="2" Background="Transparent" />
            </Grid>

            <!-- Address Bar inside TitleBar, centered -->
            <TextBox Grid.Column="1"
                     x:Name="AddressBar"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="Search or enter web address"
                     Margin="8,2,8,0"
                     CornerRadius="16"
                     KeyDown="AddressBar_KeyDown" />

            <!-- Right side draggable area and space for caption buttons -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <!-- The background that acts as the draggable TitleBar on the right -->
                <Border x:Name="AppTitleBarRight" Grid.Column="0" Background="Transparent" />

                <!-- Space for system caption buttons -->
                <Grid Grid.Column="1" Background="Transparent" />
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
