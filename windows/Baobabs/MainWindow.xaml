<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Baobabs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Baobabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Baobabs"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="800" />
                <ColumnDefinition Width="*" />
                <!-- Space for system caption buttons -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Toggle Button -->
            <Button Grid.Column="0"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Toggle Sidebar">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons" />
            </Button>

            <!-- Navigation Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" />
                </Button>
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" />
                </Button>
            </StackPanel>

            <!-- Address Bar inside TitleBar -->
            <TextBox Grid.Column="2"
                     x:Name="AddressBar"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="Search or enter web address"
                     Margin="8,0,8,0">
                <TextBox.Header>
                    <TextBlock Visibility="Collapsed" />
                </TextBox.Header>
            </TextBox>

            <!-- The background that acts as the draggable TitleBar -->
            <Border x:Name="AppTitleBar" Grid.Column="3" Background="Transparent" />

            <Grid Grid.Column="4" Background="Transparent" />
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
